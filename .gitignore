# Dependencies and build output
node_modules/
dist/
tmp/
coverage/

# Local files
*.log
.DS_Store
.env
.env.*

# Design notes, contracts, the usage guide and the generated reference stay on the author's machine
docs/
# The ab-test fixture repos carry their measured plans under docs/plan-build/ (PRD 2026-11-04 R9)
!tests/fixtures/ab-test/plan-format/fixtures/*/docs/
# … and the user-language fixture carries the German plan of its stop case (PRD 2026-11-06 G5)
!tests/fixtures/ab-test/user-language/fixtures/*/docs/

# Per-machine state the buracle CLI and the code indexes write into a checkout
.codegraph/
.sembleignore
.worktrees/
.claude/settings.local.json
.claude/worktrees/

# Written by Claude Code at every mod load (also when the plugin is loaded with --plugin-dir)
harness/claude/.claude-plugin/types/
harness/claude/tsconfig.json
