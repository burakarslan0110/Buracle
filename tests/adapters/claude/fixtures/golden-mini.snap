===== README.md =====
# buracle (Claude Code plugin)

This folder is **generated** by `buracle build` from `canonical/` and `src/`; do not edit it by hand.
The repository's `.claude-plugin/marketplace.json` declares a local marketplace, and Claude Code reads the
plugin in place from this folder (`claude plugin marketplace add <repo>` and
`claude plugin install buracle@buracle --scope user`; `buracle install claude` runs both).

- Tested with Claude Code 2.1.302 (oldest supported: 2.1.290).
- `hooks/hooks.json`: the command hooks, Buracle's backbone (SessionStart, UserPromptExpansion, UserPromptSubmit, PreToolUse ^(?:Bash|Monitor|Edit|Write|MultiEdit|NotebookEdit|WebSearch|WebFetch|AskUserQuestion|Grep|Glob|Skill|PowerShell)$|mcp__.*, PostToolUse Edit|Write|MultiEdit|NotebookEdit|ExitPlanMode|AskUserQuestion, PostToolUse ^(?:TodoWrite|TaskCreate|TaskUpdate|Bash|Monitor|WebSearch|WebFetch|Read|Skill|PowerShell)$|mcp__.*, PreCompact, PostCompact, Stop, SubagentStart, SubagentStop, SessionEnd); each runs
  `bun ${CLAUDE_PLUGIN_ROOT}/bin/buracle.ts hook claude <Event>` in exec form (no shell, so Git Bash and PowerShell
  start it alike) and always runs; PreToolUse blocks the tool call when the hook cannot start or times out.
- `hooks/register.tsx`: the mod, the experience layer (the workflow band above the prompt, the consent dialog, turn receipts, output masking, commands, panes).
- `hooks/core/`: a copy of `src/core`; `hooks/generated/`: the capability catalog and the versions the mod reads.
- Skills (`/<id>`, the bare alias Buracle's texts use; `/buracle:<id>` always works, also when another command took the bare name): alpha, beta.
- Agents (`buracle:<id>`, read-only): reviewer.
- MCP servers (`mcp__plugin_buracle_<server>__*`): buracle-memory (always loaded), docs (always loaded), examples; `.lsp.json`: language servers (from Buracle's toolchain).
- `bin/`: `buracle` (on the Bash tool's PATH), `buracle.ts` (the launcher of the hooks, the MCP and the language servers), `buracle.cmd` (Windows, on the PowerShell tool's PATH).
- `settings.json`: `subagentStatusLine` (plugin settings accept only `agent` and `subagentStatusLine`).

Checks: `claude plugin validate --strict --json harness/claude` (must pass with no error and no warning) and
`claude plugin test harness/claude`.
===== agents/reviewer.md =====
---
name: reviewer
description: "Read-only reviewer for the golden test. Launch it from `/alpha` after implementation."
tools: "Read, Bash, mcp__plugin_buracle_docs__*"
disallowedTools: "Write, Edit, NotebookEdit"
model: sonnet
---

You review changes. Ask nothing; use `AskUserQuestion` never.

Return only JSON.
===== bin/buracle (mode 755) =====
#!/bin/sh
# Buracle's launcher in the plugin: the buracle CLI on the Bash tool's PATH while the plugin is
# enabled (the command hooks run bin/buracle.ts with bun, no shell). Runs the shim `buracle install` writes
# (~/.buracle/bin/buracle, or $BURACLE_HOME/bin/buracle; it names bun by its absolute path), else bun
# with bin/buracle.ts next to this file (Windows, where the shim is buracle.cmd, and a missing shim).
b="${BURACLE_HOME:-$HOME/.buracle}/bin/buracle"
if [ -x "$b" ]; then exec "$b" "$@"; fi
d=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if command -v bun >/dev/null 2>&1; then exec bun "$d/buracle.ts" "$@"; fi
# Neither the shim nor bun: nothing of Buracle can run. A guard hook (PreToolUse) denies the call
# (fail closed; `buracle uninstall` removes this plugin, so only a broken install gets here);
# every other hook does nothing.
if [ "$1" = hook ]; then
  if [ "$3" = PreToolUse ]; then printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Buracle blocked this tool call: the buracle shim (~/.buracle/bin/buracle) and bun are both missing, so its guards (H01, H02, H20) cannot run. Ask the user to install bun and run `bun src/cli/main.ts install` in the Buracle checkout, or to remove Buracle'\''s plugin with `claude plugin uninstall buracle@buracle`."}}'; fi
  exit 0
fi
echo "buracle: $b not found and bun is not on PATH; run 'bun src/cli/main.ts install' in the Buracle repository" >&2
exit 127
===== bin/buracle.cmd =====
@echo off
rem GENERATED by `buracle build`. Do not edit.
bun "%~dp0buracle.ts" %*
===== bin/buracle.ts (mode 755) =====
#!/usr/bin/env bun
// GENERATED by `buracle build` (src/adapters/claude/plugin.ts). Do not edit.
// Buracle's launcher inside the Claude Code plugin: `bun <plugin>/bin/buracle.ts <args>` runs the
// Buracle CLI in this process: the frozen runtime the shim runs, else the checkout. The command hooks,
// MCP servers and language servers use it, and bin/buracle when there is no shim.
import { existsSync, readFileSync } from 'node:fs'
import { homedir } from 'node:os'
import { join, resolve } from 'node:path'

const HOME = (process.env['HOME'] ?? '').trim() || homedir()
const BURACLE_HOME = (process.env['BURACLE_HOME'] ?? '').trim() || join(HOME, '.buracle')
const REASON_PRE = "Buracle blocked this tool call: its guard hook could not run ("
const REASON_POST = "). The guards (H01, H02, H20) must check every call, so calls stay blocked until Buracle works again. Ask the user to run `! buracle doctor` and then `! buracle install` in this session; the log is ~/.buracle/logs/buracle.log."

function isCheckout(dir: string): boolean {
  return existsSync(join(dir, 'canonical', 'buracle.yaml')) && existsSync(join(dir, 'src', 'cli', 'router.ts'))
}

/** The tree the shim runs (its frozen runtime, or the checkout), read from the POSIX shim. */
function shimTree(): string | undefined {
  try {
    const text = readFileSync(join(BURACLE_HOME, 'bin', 'buracle'), 'utf8')
    const main = /^m='((?:[^']|'\\'')*)'$/m.exec(text)?.[1] ?? /^exec '(?:[^']|'\\'')*' '((?:[^']|'\\'')*)' "\$@"$/m.exec(text)?.[1]
    if (main === undefined) return undefined
    const dir = resolve(main.replace(/'\\''/g, "'"), '..', '..', '..')
    return isCheckout(dir) ? dir : undefined
  } catch { return undefined }
}

function checkout(): string | undefined {
  const here = resolve(import.meta.dir, '..', '..', '..')
  if (isCheckout(here)) return here
  try {
    const snap = JSON.parse(readFileSync(join(BURACLE_HOME, 'state', 'runtime-config.json'), 'utf8')) as { resolved?: { repoRoot?: unknown } }
    const r = snap.resolved?.repoRoot
    if (typeof r === 'string' && isCheckout(r)) return r
  } catch { /* no snapshot yet */ }
  try {
    const m = /^repo:\s*['"]?([^'"\n]+?)['"]?\s*$/m.exec(readFileSync(join(BURACLE_HOME, 'config.yaml'), 'utf8'))
    const r = m?.[1]?.replace(/^~(?=$|[\\/])/, HOME)
    if (r !== undefined && isCheckout(r)) return r
  } catch { /* no config yet */ }
  return undefined
}

const argv = process.argv.slice(2)

/** A hook that cannot run: a guard hook (PreToolUse) denies the call, any other does nothing. */
function failHook(detail: string): never {
  if (argv[2] === 'PreToolUse' && (argv[1] === 'claude' || argv[1] === 'codex')) {
    process.stdout.write(JSON.stringify({ hookSpecificOutput: { hookEventName: 'PreToolUse', permissionDecision: 'deny', permissionDecisionReason: REASON_PRE + detail + REASON_POST } }) + '\n')
  }
  process.exit(0)
}

const root = shimTree() ?? checkout()
if (root === undefined) {
  if (argv[0] === 'hook') failHook('no Buracle runtime or checkout was found')
  process.stderr.write("buracle: the Buracle checkout was not found; run 'bun src/cli/main.ts install' in it\n")
  process.exit(127)
}
let runProcess: (argv: readonly string[]) => Promise<number>
try {
  ({ runProcess } = (await import(join(root, 'src', 'cli', 'router.ts'))) as { runProcess(argv: readonly string[]): Promise<number> })
} catch (e) {
  const why = String(e instanceof Error ? e.message : e).split('\n')[0] ?? ''
  if (argv[0] === 'hook') failHook(`Buracle's CLI in ${root} cannot load: ${why}`)
  process.stderr.write(`buracle: the CLI in ${root} cannot load: ${why}\n`)
  process.exit(1)
}
process.exit(await runProcess(argv))
