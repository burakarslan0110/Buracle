{
  "mcpServers": {
    "buracle-memory": {
      "args": [
        "-c",
        "exec \"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" \"$@\"",
        "buracle",
        "mcp",
        "memory"
      ],
      "command": "/bin/sh",
      "env": {
        "BURACLE_HARNESS": "pi"
      },
      "type": "stdio"
    },
    "chrome-devtools": {
      "args": [
        "-c",
        "exec \"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" \"$@\"",
        "buracle",
        "mcp",
        "run",
        "chrome-devtools"
      ],
      "command": "/bin/sh",
      "env": {
        "BURACLE_HARNESS": "pi"
      },
      "type": "stdio"
    },
    "codegraph": {
      "args": [
        "-c",
        "exec \"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" \"$@\"",
        "buracle",
        "mcp",
        "run",
        "codegraph"
      ],
      "command": "/bin/sh",
      "env": {
        "BURACLE_HARNESS": "pi",
        "CODEGRAPH_MCP_TOOLS": "explore,search,node,callers,callees,impact,status,files",
        "CODEGRAPH_NO_UPDATE_CHECK": "1",
        "CODEGRAPH_NO_WATCHDOG": "1",
        "CODEGRAPH_TELEMETRY": "0"
      },
      "type": "stdio"
    },
    "context7": {
      "args": [
        "-c",
        "exec \"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" \"$@\"",
        "buracle",
        "mcp",
        "run",
        "context7"
      ],
      "command": "/bin/sh",
      "env": {
        "BURACLE_HARNESS": "pi"
      },
      "type": "stdio"
    },
    "grep": {
      "type": "http",
      "url": "https://mcp.grep.app"
    },
    "semble": {
      "args": [
        "-c",
        "exec \"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" \"$@\"",
        "buracle",
        "mcp",
        "run",
        "semble"
      ],
      "command": "/bin/sh",
      "env": {
        "BURACLE_HARNESS": "pi",
        "HF_HUB_DISABLE_TELEMETRY": "1"
      },
      "type": "stdio"
    },
    "web-fetch": {
      "args": [
        "-c",
        "exec \"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" \"$@\"",
        "buracle",
        "mcp",
        "run",
        "web-fetch"
      ],
      "command": "/bin/sh",
      "env": {
        "BURACLE_HARNESS": "pi"
      },
      "timeout": 180,
      "type": "stdio"
    },
    "web-search": {
      "args": [
        "-c",
        "exec \"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" \"$@\"",
        "buracle",
        "mcp",
        "run",
        "web-search"
      ],
      "command": "/bin/sh",
      "env": {
        "BURACLE_HARNESS": "pi",
        "DEFAULT_SEARCH_ENGINE": "duckduckgo",
        "MODE": "stdio"
      },
      "type": "stdio"
    }
  }
}
