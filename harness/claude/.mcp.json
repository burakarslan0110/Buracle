{
  "mcpServers": {
    "buracle-memory": {
      "command": "bun",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/buracle.ts",
        "mcp",
        "memory"
      ],
      "alwaysLoad": true
    },
    "chrome-devtools": {
      "command": "bun",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/buracle.ts",
        "mcp",
        "run",
        "chrome-devtools"
      ],
      "env": {
        "BURACLE_HARNESS": "claude"
      }
    },
    "codegraph": {
      "command": "bun",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/buracle.ts",
        "mcp",
        "run",
        "codegraph"
      ],
      "env": {
        "CODEGRAPH_MCP_TOOLS": "explore,search,node,callers,callees,impact,status,files",
        "CODEGRAPH_NO_UPDATE_CHECK": "1",
        "CODEGRAPH_NO_WATCHDOG": "1",
        "CODEGRAPH_TELEMETRY": "0",
        "BURACLE_HARNESS": "claude"
      },
      "alwaysLoad": true
    },
    "context7": {
      "command": "bun",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/buracle.ts",
        "mcp",
        "run",
        "context7"
      ],
      "env": {
        "BURACLE_HARNESS": "claude"
      },
      "alwaysLoad": true
    },
    "grep": {
      "type": "http",
      "url": "https://mcp.grep.app"
    },
    "semble": {
      "command": "bun",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/buracle.ts",
        "mcp",
        "run",
        "semble"
      ],
      "env": {
        "HF_HUB_DISABLE_TELEMETRY": "1",
        "BURACLE_HARNESS": "claude"
      },
      "alwaysLoad": true
    },
    "web-fetch": {
      "command": "bun",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/buracle.ts",
        "mcp",
        "run",
        "web-fetch"
      ],
      "env": {
        "BURACLE_HARNESS": "claude"
      },
      "timeout": 180000,
      "alwaysLoad": true
    },
    "web-search": {
      "command": "bun",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/buracle.ts",
        "mcp",
        "run",
        "web-search"
      ],
      "env": {
        "DEFAULT_SEARCH_ENGINE": "duckduckgo",
        "MODE": "stdio",
        "BURACLE_HARNESS": "claude"
      },
      "alwaysLoad": true
    }
  }
}
