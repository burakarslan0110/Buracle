# Buracle: catastrophic shell commands Codex must never run (execpolicy, decision "forbidden").
# Generated by Buracle from src/adapters/codex/execpolicy.ts; edits here are overwritten by `buracle install`.
# Best effort: prefix rules see plain commands only, so the Buracle PreToolUse guard (H01) stays the broader net.
# Check a command with: codex execpolicy check --rules ~/.codex/rules/buracle.rules -- <command…>

RM = [
    "rm", "/bin/rm",
]

SUDO = [
    "sudo", "/usr/bin/sudo",
]

RECURSIVE_FORCE = [
    "-Rdf", "-Rdfv", "-Rdvf", "-Rf", "-Rfd", "-Rfdv", "-Rfv", "-Rfvd", "-Rvdf", "-Rvf", "-Rvfd", "-dRf",
    "-dRfv", "-dRvf", "-dfR", "-dfRv", "-dfr", "-dfrv", "-dfvR", "-dfvr", "-drf", "-drfv", "-drvf",
    "-dvRf", "-dvfR", "-dvfr", "-dvrf", "-fR", "-fRd", "-fRdv", "-fRv", "-fRvd", "-fdR", "-fdRv", "-fdr",
    "-fdrv", "-fdvR", "-fdvr", "-fr", "-frd", "-frdv", "-frv", "-frvd", "-fvR", "-fvRd", "-fvdR",
    "-fvdr", "-fvr", "-fvrd", "-rdf", "-rdfv", "-rdvf", "-rf", "-rfd", "-rfdv", "-rfv", "-rfvd", "-rvdf",
    "-rvf", "-rvfd", "-vRdf", "-vRf", "-vRfd", "-vdRf", "-vdfR", "-vdfr", "-vdrf", "-vfR", "-vfRd",
    "-vfdR", "-vfdr", "-vfr", "-vfrd", "-vrdf", "-vrf", "-vrfd",
]

RECURSIVE = [
    "-r", "-R", "--recursive",
]

FORCE = [
    "-f", "--force",
]

END_OF_OPTIONS = [
    "--", "--no-preserve-root",
]

TARGETS = [
    "$HOME", "$HOME/", "$HOME/*", "$HOME/.aws", "$HOME/.aws/", "$HOME/.aws/*", "$HOME/.buracle",
    "$HOME/.buracle/", "$HOME/.buracle/*", "$HOME/.claude", "$HOME/.claude/", "$HOME/.claude/*",
    "$HOME/.codex", "$HOME/.codex/", "$HOME/.codex/*", "$HOME/.config", "$HOME/.config/",
    "$HOME/.config/*", "$HOME/.gnupg", "$HOME/.gnupg/", "$HOME/.gnupg/*", "$HOME/.ssh", "$HOME/.ssh/",
    "$HOME/.ssh/*", "$HOME/Applications", "$HOME/Applications/", "$HOME/Applications/*", "$HOME/Desktop",
    "$HOME/Desktop/", "$HOME/Desktop/*", "$HOME/Documents", "$HOME/Documents/", "$HOME/Documents/*",
    "$HOME/Downloads", "$HOME/Downloads/", "$HOME/Downloads/*", "$HOME/Library", "$HOME/Library/",
    "$HOME/Library/*", "$HOME/Movies", "$HOME/Movies/", "$HOME/Movies/*", "$HOME/Music", "$HOME/Music/",
    "$HOME/Music/*", "$HOME/Pictures", "$HOME/Pictures/", "$HOME/Pictures/*", "$HOME/Public",
    "$HOME/Public/", "$HOME/Public/*", "${HOME}", "${HOME}/", "${HOME}/*", "${HOME}/.aws",
    "${HOME}/.aws/", "${HOME}/.aws/*", "${HOME}/.buracle", "${HOME}/.buracle/", "${HOME}/.buracle/*",
    "${HOME}/.claude", "${HOME}/.claude/", "${HOME}/.claude/*", "${HOME}/.codex", "${HOME}/.codex/",
    "${HOME}/.codex/*", "${HOME}/.config", "${HOME}/.config/", "${HOME}/.config/*", "${HOME}/.gnupg",
    "${HOME}/.gnupg/", "${HOME}/.gnupg/*", "${HOME}/.ssh", "${HOME}/.ssh/", "${HOME}/.ssh/*",
    "${HOME}/Applications", "${HOME}/Applications/", "${HOME}/Applications/*", "${HOME}/Desktop",
    "${HOME}/Desktop/", "${HOME}/Desktop/*", "${HOME}/Documents", "${HOME}/Documents/",
    "${HOME}/Documents/*", "${HOME}/Downloads", "${HOME}/Downloads/", "${HOME}/Downloads/*",
    "${HOME}/Library", "${HOME}/Library/", "${HOME}/Library/*", "${HOME}/Movies", "${HOME}/Movies/",
    "${HOME}/Movies/*", "${HOME}/Music", "${HOME}/Music/", "${HOME}/Music/*", "${HOME}/Pictures",
    "${HOME}/Pictures/", "${HOME}/Pictures/*", "${HOME}/Public", "${HOME}/Public/", "${HOME}/Public/*",
    "/", "/*", "/.", "/Applications", "/Applications/", "/Applications/*", "/Library", "/Library/",
    "/Library/*", "/System", "/System/", "/System/*", "/Users", "/Users/", "/Users/*", "/Volumes",
    "/Volumes/", "/Volumes/*", "/bin", "/bin/", "/bin/*", "/cores", "/cores/", "/cores/*", "/etc",
    "/etc/", "/etc/*", "/home", "/home/", "/home/*", "/opt", "/opt/", "/opt/*", "/opt/homebrew",
    "/opt/homebrew/", "/opt/homebrew/*", "/private", "/private/", "/private/*", "/private/etc",
    "/private/etc/", "/private/etc/*", "/private/var", "/private/var/", "/private/var/*", "/root",
    "/root/", "/root/*", "/sbin", "/sbin/", "/sbin/*", "/tmp", "/tmp/", "/tmp/*", "/usr", "/usr/",
    "/usr/*", "/usr/bin", "/usr/bin/", "/usr/bin/*", "/usr/lib", "/usr/lib/", "/usr/lib/*", "/usr/local",
    "/usr/local/", "/usr/local/*", "/usr/sbin", "/usr/sbin/", "/usr/sbin/*", "/var", "/var/", "/var/*",
    "~", "~/", "~/*", "~/.aws", "~/.aws/", "~/.aws/*", "~/.buracle", "~/.buracle/", "~/.buracle/*",
    "~/.claude", "~/.claude/", "~/.claude/*", "~/.codex", "~/.codex/", "~/.codex/*", "~/.config",
    "~/.config/", "~/.config/*", "~/.gnupg", "~/.gnupg/", "~/.gnupg/*", "~/.ssh", "~/.ssh/", "~/.ssh/*",
    "~/Applications", "~/Applications/", "~/Applications/*", "~/Desktop", "~/Desktop/", "~/Desktop/*",
    "~/Documents", "~/Documents/", "~/Documents/*", "~/Downloads", "~/Downloads/", "~/Downloads/*",
    "~/Library", "~/Library/", "~/Library/*", "~/Movies", "~/Movies/", "~/Movies/*", "~/Music",
    "~/Music/", "~/Music/*", "~/Pictures", "~/Pictures/", "~/Pictures/*", "~/Public", "~/Public/",
    "~/Public/*",
]

GIT_DIR = [
    ".git", ".git/", "./.git", "./.git/",
]

GIT_FORCE = [
    "--force", "-f", "-fu", "-uf", "-fq", "-qf", "-fv", "-vf", "--force-w", "--force-wi", "--force-wit",
    "--force-with", "--force-with-", "--force-with-l", "--force-with-le", "--force-with-lea",
    "--force-with-leas", "--force-with-lease",
]

MIRROR = [
    "--m", "--mi", "--mir", "--mirr", "--mirro", "--mirror",
]

ALL = [
    "--al", "--all", "--b", "--br", "--bra", "--bran", "--branc", "--branch", "--branche", "--branches",
]

REMOTES = [
    "origin", "upstream",
]

DEFAULT_BRANCH = [
    "main", "master", "HEAD:main", "HEAD:master", "main:main", "master:master", "refs/heads/main",
    "refs/heads/master", "HEAD:refs/heads/main", "HEAD:refs/heads/master",
]

FORCED_DEFAULT_BRANCH = [
    "+main", "+master", "+HEAD:main", "+HEAD:master", "+refs/heads/main", "+refs/heads/master",
    "+HEAD:refs/heads/main", "+HEAD:refs/heads/master", "+refs/heads/*:refs/heads/*",
]

EVERY_BRANCH = [
    "--al", "--all", "--b", "--br", "--bra", "--bran", "--branc", "--branch", "--branche", "--branches",
    "refs/heads/*", "refs/heads/*:refs/heads/*",
]

prefix_rule(
    pattern = [RM, RECURSIVE_FORCE, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["rm -rf /", "rm -fr ~", "rm -Rf /usr", "/bin/rm -rfv $HOME/", "rm -rf ~/Documents"],
    not_match = ["rm -rf ./dist", "rm -rf /tmp/build-cache", "rm -rf node_modules"],
)

prefix_rule(
    pattern = [RM, RECURSIVE_FORCE, END_OF_OPTIONS, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["rm -rf -- /", "rm -rf --no-preserve-root /"],
    not_match = ["rm -rf -- dist"],
)

prefix_rule(
    pattern = [RM, RECURSIVE_FORCE, "--no-preserve-root", "--", TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["rm -rf --no-preserve-root -- /"],
    not_match = ["rm -rf --no-preserve-root -- build"],
)

prefix_rule(
    pattern = [RM, "--no-preserve-root", RECURSIVE_FORCE, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["rm --no-preserve-root -rf /"],
    not_match = ["rm --no-preserve-root -rf build"],
)

prefix_rule(
    pattern = [RM, RECURSIVE, FORCE, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["rm -r -f /", "rm --recursive --force ~"],
    not_match = ["rm -r -f ./build"],
)

prefix_rule(
    pattern = [RM, FORCE, RECURSIVE, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["rm -f -r /", "rm --force --recursive ~/"],
    not_match = ["rm -f -r ./build"],
)

prefix_rule(
    pattern = [RM, RECURSIVE, FORCE, END_OF_OPTIONS, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["rm -r -f -- ~"],
    not_match = ["rm -r -f -- ./build"],
)

prefix_rule(
    pattern = [RM, FORCE, RECURSIVE, END_OF_OPTIONS, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["rm -f -r --no-preserve-root /"],
    not_match = ["rm -f -r -- ./build"],
)

prefix_rule(
    pattern = [RM, RECURSIVE, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["rm -r ~", "rm -R /usr"],
    not_match = ["rm -r ./build"],
)

prefix_rule(
    pattern = [SUDO, RM, RECURSIVE_FORCE, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["sudo rm -rf /", "sudo rm -fr ~", "sudo rm -Rf /usr", "sudo /bin/rm -rfv $HOME/", "sudo rm -rf ~/Documents"],
    not_match = ["sudo rm -rf ./dist", "sudo rm -rf /tmp/build-cache", "sudo rm -rf node_modules"],
)

prefix_rule(
    pattern = [SUDO, RM, RECURSIVE_FORCE, END_OF_OPTIONS, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["sudo rm -rf -- /", "sudo rm -rf --no-preserve-root /"],
    not_match = ["sudo rm -rf -- dist"],
)

prefix_rule(
    pattern = [SUDO, RM, RECURSIVE_FORCE, "--no-preserve-root", "--", TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["sudo rm -rf --no-preserve-root -- /"],
    not_match = ["sudo rm -rf --no-preserve-root -- build"],
)

prefix_rule(
    pattern = [SUDO, RM, "--no-preserve-root", RECURSIVE_FORCE, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["sudo rm --no-preserve-root -rf /"],
    not_match = ["sudo rm --no-preserve-root -rf build"],
)

prefix_rule(
    pattern = [SUDO, RM, RECURSIVE, FORCE, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["sudo rm -r -f /", "sudo rm --recursive --force ~"],
    not_match = ["sudo rm -r -f ./build"],
)

prefix_rule(
    pattern = [SUDO, RM, FORCE, RECURSIVE, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["sudo rm -f -r /", "sudo rm --force --recursive ~/"],
    not_match = ["sudo rm -f -r ./build"],
)

prefix_rule(
    pattern = [SUDO, RM, RECURSIVE, FORCE, END_OF_OPTIONS, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["sudo rm -r -f -- ~"],
    not_match = ["sudo rm -r -f -- ./build"],
)

prefix_rule(
    pattern = [SUDO, RM, FORCE, RECURSIVE, END_OF_OPTIONS, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["sudo rm -f -r --no-preserve-root /"],
    not_match = ["sudo rm -f -r -- ./build"],
)

prefix_rule(
    pattern = [SUDO, RM, RECURSIVE, TARGETS],
    decision = "forbidden",
    justification = "Recursive force delete of the filesystem root, a system directory, the home directory or one of its key folders. Delete the specific paths you mean instead, or ask the user.",
    match = ["sudo rm -r ~", "sudo rm -R /usr"],
    not_match = ["sudo rm -r ./build"],
)

prefix_rule(
    pattern = [RM, ["-Rdf", "-Rdfv", "-Rdvf", "-Rf", "-Rfd", "-Rfdv", "-Rfv", "-Rfvd", "-Rvdf", "-Rvf", "-Rvfd", "-dRf", "-dRfv", "-dRvf", "-dfR", "-dfRv", "-dfr", "-dfrv", "-dfvR", "-dfvr", "-drf", "-drfv", "-drvf", "-dvRf", "-dvfR", "-dvfr", "-dvrf", "-fR", "-fRd", "-fRdv", "-fRv", "-fRvd", "-fdR", "-fdRv", "-fdr", "-fdrv", "-fdvR", "-fdvr", "-fr", "-frd", "-frdv", "-frv", "-frvd", "-fvR", "-fvRd", "-fvdR", "-fvdr", "-fvr", "-fvrd", "-rdf", "-rdfv", "-rdvf", "-rf", "-rfd", "-rfdv", "-rfv", "-rfvd", "-rvdf", "-rvf", "-rvfd", "-vRdf", "-vRf", "-vRfd", "-vdRf", "-vdfR", "-vdfr", "-vdrf", "-vfR", "-vfRd", "-vfdR", "-vfdr", "-vfr", "-vfrd", "-vrdf", "-vrf", "-vrfd", "-r", "-R", "--recursive"], GIT_DIR],
    decision = "forbidden",
    justification = "Deleting .git destroys the repository history. Use git commands (reset, restore, worktree remove) instead.",
    match = ["rm -rf .git", "rm -r ./.git", "rm -rf .git/"],
    not_match = ["rm -rf .github", "rm -rf .gitignore"],
)

prefix_rule(
    pattern = [RM, ["-Rdf", "-Rdfv", "-Rdvf", "-Rf", "-Rfd", "-Rfdv", "-Rfv", "-Rfvd", "-Rvdf", "-Rvf", "-Rvfd", "-dRf", "-dRfv", "-dRvf", "-dfR", "-dfRv", "-dfr", "-dfrv", "-dfvR", "-dfvr", "-drf", "-drfv", "-drvf", "-dvRf", "-dvfR", "-dvfr", "-dvrf", "-fR", "-fRd", "-fRdv", "-fRv", "-fRvd", "-fdR", "-fdRv", "-fdr", "-fdrv", "-fdvR", "-fdvr", "-fr", "-frd", "-frdv", "-frv", "-frvd", "-fvR", "-fvRd", "-fvdR", "-fvdr", "-fvr", "-fvrd", "-rdf", "-rdfv", "-rdvf", "-rf", "-rfd", "-rfdv", "-rfv", "-rfvd", "-rvdf", "-rvf", "-rvfd", "-vRdf", "-vRf", "-vRfd", "-vdRf", "-vdfR", "-vdfr", "-vdrf", "-vfR", "-vfRd", "-vfdR", "-vfdr", "-vfr", "-vfrd", "-vrdf", "-vrf", "-vrfd", "-r", "-R", "--recursive"], "--", GIT_DIR],
    decision = "forbidden",
    justification = "Deleting .git destroys the repository history. Use git commands (reset, restore, worktree remove) instead.",
    match = ["rm -rf -- .git"],
    not_match = ["rm -rf -- .github"],
)

prefix_rule(
    pattern = ["git", "push", GIT_FORCE, REMOTES, DEFAULT_BRANCH],
    decision = "forbidden",
    justification = "Force-pushing the default branch (or every branch) rewrites shared history. Push a branch and open a pull request, or ask the user.",
    match = ["git push --force origin main", "git push -f upstream master", "git push --force-with-lease origin main", "git push -f origin HEAD:main", "git push --force-w origin main", "git push -fu origin main"],
    not_match = ["git push --force origin feature/x", "git push origin main"],
)

prefix_rule(
    pattern = ["git", "push", REMOTES, GIT_FORCE, DEFAULT_BRANCH],
    decision = "forbidden",
    justification = "Force-pushing the default branch (or every branch) rewrites shared history. Push a branch and open a pull request, or ask the user.",
    match = ["git push origin -f main", "git push origin --force-with-lease HEAD:master"],
    not_match = ["git push origin -f feature/x"],
)

prefix_rule(
    pattern = ["git", "push", REMOTES, DEFAULT_BRANCH, GIT_FORCE],
    decision = "forbidden",
    justification = "Force-pushing the default branch (or every branch) rewrites shared history. Push a branch and open a pull request, or ask the user.",
    match = ["git push origin main --force", "git push upstream master -f", "git push origin main:main --force-with-lease"],
    not_match = ["git push origin main --tags"],
)

prefix_rule(
    pattern = ["git", "push", REMOTES, FORCED_DEFAULT_BRANCH],
    decision = "forbidden",
    justification = "A \"+\" refspec force-pushes the default branch and rewrites shared history. Push a branch instead.",
    match = ["git push origin +main", "git push origin +HEAD:master", "git push origin +refs/heads/*:refs/heads/*"],
    not_match = ["git push origin +feature"],
)

prefix_rule(
    pattern = ["git", "push", GIT_FORCE, REMOTES, EVERY_BRANCH],
    decision = "forbidden",
    justification = "Force-pushing the default branch (or every branch) rewrites shared history. Push a branch and open a pull request, or ask the user.",
    match = ["git push --force origin refs/heads/*", "git push -f origin --all"],
    not_match = ["git push --force origin refs/heads/feature"],
)

prefix_rule(
    pattern = ["git", "push", GIT_FORCE, ALL],
    decision = "forbidden",
    justification = "Force-pushing the default branch (or every branch) rewrites shared history. Push a branch and open a pull request, or ask the user.",
    match = ["git push --force --all origin", "git push -f --branches origin"],
    not_match = ["git push --force --tags origin"],
)

prefix_rule(
    pattern = ["git", "push", ALL, GIT_FORCE],
    decision = "forbidden",
    justification = "Force-pushing the default branch (or every branch) rewrites shared history. Push a branch and open a pull request, or ask the user.",
    match = ["git push --all --force origin", "git push --al -f origin"],
    not_match = ["git push --all origin"],
)

prefix_rule(
    pattern = ["git", "push", MIRROR],
    decision = "forbidden",
    justification = "A mirror push force-updates and deletes every ref on the remote. Push the branch you mean instead, or ask the user.",
    match = ["git push --mirror origin", "git push --mirr origin"],
    not_match = ["git push origin main"],
)

prefix_rule(
    pattern = ["git", "push", REMOTES, MIRROR],
    decision = "forbidden",
    justification = "A mirror push force-updates and deletes every ref on the remote. Push the branch you mean instead, or ask the user.",
    match = ["git push origin --mirror", "git push origin --mi"],
    not_match = ["git push origin --tags"],
)

prefix_rule(
    pattern = [["diskutil", "/usr/sbin/diskutil"], ["eraseDisk", "eraseVolume", "partitionDisk", "secureErase", "zeroDisk", "randomDisk", "reformat"]],
    decision = "forbidden",
    justification = "Erasing or repartitioning a disk destroys data. Never run this from an agent.",
    match = ["diskutil eraseDisk APFS Untitled disk2", "diskutil zeroDisk disk3"],
    not_match = ["diskutil list", "diskutil info disk0"],
)

prefix_rule(
    pattern = [SUDO, ["diskutil", "/usr/sbin/diskutil"], ["eraseDisk", "eraseVolume", "partitionDisk", "secureErase", "zeroDisk", "randomDisk", "reformat"]],
    decision = "forbidden",
    justification = "Erasing or repartitioning a disk destroys data. Never run this from an agent.",
    match = ["sudo diskutil eraseDisk APFS x disk2"],
    not_match = ["sudo diskutil list"],
)

prefix_rule(
    pattern = [["mkfs", "mkfs.ext4", "mkfs.ext3", "mkfs.xfs", "mkfs.btrfs", "mkfs.vfat", "mkfs.fat", "mkfs.exfat", "newfs_apfs", "newfs_hfs", "newfs_msdos"]],
    decision = "forbidden",
    justification = "Creating a filesystem erases the target device. Never run this from an agent.",
    match = ["mkfs.ext4 /dev/sdb1", "newfs_apfs /dev/disk4"],
    not_match = ["mkdir build"],
)

prefix_rule(
    pattern = [SUDO, ["mkfs", "mkfs.ext4", "mkfs.ext3", "mkfs.xfs", "mkfs.btrfs", "mkfs.vfat", "mkfs.fat", "mkfs.exfat", "newfs_apfs", "newfs_hfs", "newfs_msdos"]],
    decision = "forbidden",
    justification = "Creating a filesystem erases the target device. Never run this from an agent.",
    match = ["sudo mkfs.ext4 /dev/sdb1"],
    not_match = ["sudo mkdir build"],
)

prefix_rule(
    pattern = [["chmod", "/bin/chmod"], "-R", ["777", "0777", "000", "0000", "a+rwx", "a-rwx", "ugo+rwx"], TARGETS],
    decision = "forbidden",
    justification = "Recursively changing permissions of the root or home directory breaks the system and leaks secrets. Change the specific paths you mean instead.",
    match = ["chmod -R 777 /", "chmod -R 000 ~"],
    not_match = ["chmod -R 755 ./scripts"],
)

prefix_rule(
    pattern = [SUDO, ["chmod", "/bin/chmod"], "-R", ["777", "0777", "000", "0000", "a+rwx", "a-rwx", "ugo+rwx"], TARGETS],
    decision = "forbidden",
    justification = "Recursively changing permissions of the root or home directory breaks the system and leaks secrets. Change the specific paths you mean instead.",
    match = ["sudo chmod -R 777 /"],
    not_match = ["sudo chmod -R 755 ./scripts"],
)
