{
  "description": "Buracle hooks for Codex CLI (generated by `buracle build`). Each command is a constant `buracle hook codex <Event>` call, so approving them once in /hooks survives Buracle updates.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" hook codex SessionStart",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" hook codex UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|request_user_input|request_user_input_async|mcp__.+)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" hook codex PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^(Bash|mcp__.+)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" hook codex PermissionRequest",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" hook codex PostToolUse",
            "timeout": 45,
            "statusMessage": "Buracle: checking edited files"
          }
        ]
      },
      {
        "matcher": "^(Bash|webrun|mcp__.+)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" hook codex PostToolUse",
            "timeout": 15,
            "async": true
          }
        ]
      },
      {
        "matcher": "^(Bash|mcp__.+)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" hook codex PostToolUseMask",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "request_user_input",
        "hooks": [
          {
            "type": "command",
            "command": "\"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" hook codex PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" hook codex PreCompact",
            "timeout": 20
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" hook codex PostCompact",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" hook codex Stop",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" hook codex SubagentStart",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" hook codex SubagentStop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${BURACLE_HOME:-$HOME/.buracle}/bin/buracle\" hook codex SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
